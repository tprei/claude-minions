{
  "name": "@minions/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "pnpm --filter @minions/shared run build && tsc --noEmit",
    "typecheck": "pnpm --filter @minions/shared run build && tsc --noEmit",
    "test": "vitest run",
    "test:chaos": "MWF_CHAOS=1 vitest run test/chaos/regressions.chaos.test.ts",
    "dogfood:verify": "tsx scripts/dogfood.ts",
    "start": "tsx src/main.ts",
    "dev": "MWF_DB_PATH=${MWF_DB_PATH:-/tmp/engine-port-dev.db} MWF_PORT=${MWF_PORT:-3000} MWF_DATA_DIR=${MWF_DATA_DIR:-/tmp/engine-port-data} tsx watch src/main.ts",
    "smoke": "rm -f /tmp/engine-port-smoke.db && tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@minions/shared": "workspace:*",
    "@hono/node-server": "^2.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "hono": "^4.12.17",
    "tsx": "^4.20.6",
    "web-push": "^3.6.7"
  }
}
