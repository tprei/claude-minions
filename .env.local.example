# Copy to .env.local (gitignored) and fill in your values.
# The engine launcher (bin/engine.sh) sources this on startup.

# Required: bearer token for REST + SSE. Use a unique secret before exposing
# the engine beyond your local machine.
MWF_TOKEN=devtoken

# Bind address + storage.
MWF_PORT=3000
MWF_HOST=127.0.0.1
MWF_DB_PATH=/tmp/engine-port-dev.db
MWF_DATA_DIR=/tmp/engine-port-data
MWF_WORKSPACE_ROOT=/tmp/engine-port-workspace

# Bound repos. The engine reads <MWF_WORKSPACE_ROOT>/repos.json by default.
# You can also point at an explicit file.
# MWF_REPOS_FILE=/path/to/repos.json

# Provider: claude-code, codex, pi, or stub.
MWF_PROVIDER=claude-code

# Logging: debug | info | warn | error.
MWF_LOG_LEVEL=info

# Optional: serve a built PWA from the engine.
# MWF_PWA_DIR=/path/to/packages/web/dist

# Optional: kill and recover an agent runtime after this many ms with no output.
# MWF_RUNTIME_IDLE_TIMEOUT_MS=600000

# Optional: GitHub integration.
# MWF_GITHUB_TOKEN=
# MWF_GITHUB_REPO_OWNER=
# MWF_GITHUB_REPO_NAME=
# MWF_GITHUB_BASE_BRANCH=main

# Optional: web-push.
# MWF_VAPID_PUBLIC_KEY=
# MWF_VAPID_PRIVATE_KEY=
# MWF_VAPID_SUBJECT=mailto:ops@example.com
